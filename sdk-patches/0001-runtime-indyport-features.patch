+// Scene effects: screen space ambient occlusion and bloom, on the main target once the title's 3D scene is drawn
+// (State::hud, set by its hooks as its HUD begins) and before its HUD, so neither touches the HUD.
+// SSAO: view space positions from the reversed depth buffer and the scene's projection (the last perspective fixed
+// function draw on the main target with depth on), normals from the neighbouring depths, 12 taps on a spiral in a
+// view space radius about the point, at half size; blurred along x and y with depth weights, then multiplied into the
+// main target. Bloom: what is brighter than a threshold (by luminance: a saturated red paint is not a light),
+// at half size, down to a quarter and an eighth, each blurred, added onto the main target.
+const char* kSceneFxHlsl = R"(
+cbuffer B : register(b1) { float4 a; float4 b; float4 c; float4 d; float4 e; };
+Texture2D t0 : register(t0);
+Texture2D t1 : register(t1);
+Texture2D t2 : register(t2);
+SamplerState ls : register(s0);
+SamplerState ps : register(s1);
+struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; };
+O vs(uint id : SV_VertexID) {
+    O o;
+    float2 t = float2((id << 1) & 2, id & 2);
+    o.p = float4(t * float2(2, -2) + float2(-1, 1), 0, 1);
+    o.uv = t;
+    return o;
+}
+// the projection (row vectors): a = P00 P11 P20 P21, b = P22 P32 P30 P31, d = P32 - P33, P23 - P22, P23, P33;
+// e = the w buffer's zparams (0 for a z buffer). Depth is reversed: 1 - z/w, or zparams.x * (far w - w)
+// a w buffer (e.x != 0) holds zparams.x * (far w - w)
+float3 ViewPos(float2 uv, float depth) {
+    float z, w;
+    if (e.x != 0) {
+        w = e.y - depth / e.x;
+        z = (w - d.w) / d.z;
+    } else {
+        // nz = 1 - depth: z = (P32 - nz P33) / (nz P23 - P22), with the constant parts summed on the CPU
+        z = (d.x + depth * d.w) / (d.y - depth * d.z);
+        w = z * d.z + d.w;
+    }
+    float2 n = float2(uv.x * 2 - 1, 1 - uv.y * 2);
+    return float3((n.x * w - z * a.z - b.z) / a.x, (n.y * w - z * a.w - b.w) / a.y, z);
