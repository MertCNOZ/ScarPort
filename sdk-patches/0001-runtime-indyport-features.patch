+        uint32_t regs = uint32_t(std::popcount(a.regs));
+        if (!(a.regs & 1) || !regs || !a.vertex_count || a.vertices.size() < size_t(a.vertex_count) * regs * 4) return false;
+        lo = 1e30f;
+        hi = -1e30f;
+        if (zmax) *zmax = -1e30f;
+        for (uint32_t v = 0; v < a.vertex_count; v++) {
+            float x = a.vertices[size_t(v) * regs * 4];
+            lo = std::min(lo, x);
+            hi = std::max(hi, x);
+            if (zmax) *zmax = std::max(*zmax, a.vertices[size_t(v) * regs * 4 + 2]);
+        }
+        return true;
+    }
+    const VertexElement& e = a.elements[0];
+    if (e.buffer >= a.buffer_count) return false;
+    const VertexBuffer& vb = a.buffers[e.buffer];
+    if (!vb.src || !vb.stride) return false;
+    uint32_t n = a.index_count ? a.index_count : a.draw_count;
+    if (!n || n > 4096) return false;
+    lo = 1e30f;
+    hi = -1e30f;
+    if (zmax) *zmax = -1e30f;
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t idx = i;
+        if (a.index_src && a.index_count)
+            idx = a.index16 ? static_cast<const uint16_t*>(a.index_src)[i] : static_cast<const uint32_t*>(a.index_src)[i];
+        int64_t v = int64_t(idx) + a.base_vertex;
+        if (v < 0 || uint64_t(v) * vb.stride + e.offset + 12 > vb.bytes) return false;
+        float x, z;
+        std::memcpy(&x, vb.src + v * vb.stride + e.offset, 4);
+        std::memcpy(&z, vb.src + v * vb.stride + e.offset + 8, 4);
