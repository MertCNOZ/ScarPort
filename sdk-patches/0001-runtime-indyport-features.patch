+        c.logged = true;
+        LOGI("cube %08X %ux%u: faces from targets %c%c%c%c%c%c (host %ux%u)", d.data, d.width, d.height,
+             faces[0] ? '0' : '-', faces[1] ? '1' : '-', faces[2] ? '2' : '-', faces[3] ? '3' : '-',
+             faces[4] ? '4' : '-', faces[5] ? '5' : '-', first->w, first->h);
