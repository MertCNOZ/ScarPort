+    float2 px = c.zw;
+    float3 pr = ViewPos(i.uv + float2(px.x, 0), Depth(i.uv + float2(px.x, 0)));
+    float3 pl = ViewPos(i.uv - float2(px.x, 0), Depth(i.uv - float2(px.x, 0)));
+    float3 pd = ViewPos(i.uv + float2(0, px.y), Depth(i.uv + float2(0, px.y)));
+    float3 pu = ViewPos(i.uv - float2(0, px.y), Depth(i.uv - float2(0, px.y)));
