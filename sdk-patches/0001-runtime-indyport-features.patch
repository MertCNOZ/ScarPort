+// a 3D scene draw on the main target: its projection is the one the effects reconstruct positions with
+void D3D12Backend::NoteSceneDraw(const State& s, const Assembled& a, const DrawShaders& sh) {
+    if (s.hud || !sh.fixed_transform || a.pretransformed || ortho_draw_ || !s.rs[kRsZEnable]) return;
+    if (!bound_rt_ || !bound_ds_ || bound_rt_->gw != guest_w_ || bound_rt_->gh != guest_h_) return;
+    const float* p = s.transforms[3].data();  // D3DTS_PROJECTION (kTsProjection)
+    if (p[11] == 0 || p[0] == 0 || p[5] == 0) return;
+    std::memcpy(fx_proj_, p, sizeof(fx_proj_));
+    fx_w_[0] = fx_w_[1] = 0;
+    if (s.rs[kRsZEnable] == 2 /* D3DZB_USEW */) SceneWRange(s, fx_w_);
+    if (fx_scene_frame_ + 1 != presents_ && fx_scene_frame_ != presents_)
+        LOGI("scene effects: %s buffer, projection near %.3f far %.1f", fx_w_[0] ? "a w" : "a z", -p[14] / p[10], p[14] / (1 - p[10]));
+    fx_scene_frame_ = presents_;
+}
+
+void D3D12Backend::SceneEffects(const State& s) {
+    fx_done_frame_ = presents_;
+    const app::Settings& set = app::Get();
+    uint32_t ssao = std::min(set.ssao, 200u), bloom = std::min(set.bloom, 200u);
+    if (!ssao && !bloom) return;
+    Target* rt = FindTarget(s.rt, false);
+    Target* ds = FindTarget(s.zs, true);
+    if (!rt || rt->gw != guest_w_ || rt->gh != guest_h_) return;
+    const DXGI_FORMAT kHdr = DXGI_FORMAT_R16G16B16A16_FLOAT, kAo = DXGI_FORMAT_R8G8B8A8_UNORM;
+    D3D12_CPU_DESCRIPTOR_HANDLE main_rtv = View(*rt);
+    if (ssao && ds && ds->w == rt->w && ds->h == rt->h && EnsureFxBuf(fx_ao_[0], (rt->w + 1) / 2, (rt->h + 1) / 2, kAo) &&
+        EnsureFxBuf(fx_ao_[1], fx_ao_[0].w, fx_ao_[0].h, kAo)) {
+        const float* m = fx_proj_;
+        // the radius in view units (metres in SCAR)
+        float p[20] = {m[0], m[5], m[8], m[9], m[10], m[14], m[12], m[13],
+                       0.9f, 2.5f * float(ssao) / 100.0f, 1.0f / ds->w, 1.0f / ds->h,
+                       float(double(m[14]) - double(m[15])), float(double(m[11]) - double(m[10])), m[11], m[15],
+                       fx_w_[0], fx_w_[1]};
+        Transition(ds->res.Get(), ds->state, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        FxPass("ao", fx_ao_[0], {{nullptr, kAo}, {ds->res.Get(), kDepthRead}}, p);
+        p[10] = 1.0f / fx_ao_[0].w;
+        p[11] = 0;
+        FxPass("aoblur", fx_ao_[1], {{fx_ao_[0].res.Get(), kAo}, {ds->res.Get(), kDepthRead}}, p);
+        p[10] = 0;
+        p[11] = 1.0f / fx_ao_[0].h;
+        FxPass("aoblur", fx_ao_[0], {{fx_ao_[1].res.Get(), kAo}, {ds->res.Get(), kDepthRead}}, p);
+        Transition(rt->res.Get(), rt->state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+        FxPass("aomul", main_rtv, rt->fmt, rt->w, rt->h, {{fx_ao_[0].res.Get(), kAo}}, p, FxBlend::Multiply);
+    }
+    if (bloom && EnsureFxBuf(fx_bloom_[0], (rt->w + 1) / 2, (rt->h + 1) / 2, kHdr) &&
+        EnsureFxBuf(fx_bloom_[1], (rt->w + 3) / 4, (rt->h + 3) / 4, kHdr) &&
+        EnsureFxBuf(fx_bloom_[2], fx_bloom_[1].w, fx_bloom_[1].h, kHdr) &&
+        EnsureFxBuf(fx_bloom_[3], (rt->w + 7) / 8, (rt->h + 7) / 8, kHdr)) {
+        float p[20] = {0.72f, 0.15f};
+        Transition(rt->res.Get(), rt->state, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        FxPass("bright", fx_bloom_[0], {{rt->res.Get(), rt->fmt}}, p);
+        p[10] = 1.0f / fx_bloom_[0].w;
+        p[11] = 1.0f / fx_bloom_[0].h;
+        FxPass("down", fx_bloom_[1], {{fx_bloom_[0].res.Get(), kHdr}}, p);
+        p[10] = 1.0f / fx_bloom_[1].w;
+        p[11] = 0;
+        FxPass("blur", fx_bloom_[2], {{fx_bloom_[1].res.Get(), kHdr}}, p);
+        p[10] = 0;
+        p[11] = 1.0f / fx_bloom_[1].h;
+        FxPass("blur", fx_bloom_[1], {{fx_bloom_[2].res.Get(), kHdr}}, p);
+        p[10] = 1.0f / fx_bloom_[1].w;
+        p[11] = 1.0f / fx_bloom_[1].h;
+        FxPass("down", fx_bloom_[3], {{fx_bloom_[1].res.Get(), kHdr}}, p);
+        // the eighth blurred along x into the half buffer (free by now; sampled in uv, so its size does not matter)
+        // and back along y
+        p[10] = 1.0f / fx_bloom_[3].w;
+        p[11] = 0;
+        FxPass("blur", fx_bloom_[0], {{fx_bloom_[3].res.Get(), kHdr}}, p);
+        p[10] = 0;
+        p[11] = 1.0f / fx_bloom_[3].h;
+        FxPass("blur", fx_bloom_[3], {{fx_bloom_[0].res.Get(), kHdr}}, p);
+        p[0] = 0.6f * float(bloom) / 100.0f;
+        Transition(rt->res.Get(), rt->state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+        FxPass("bloomadd", main_rtv, rt->fmt, rt->w, rt->h, {{fx_bloom_[1].res.Get(), kHdr}, {fx_bloom_[3].res.Get(), kHdr}},
+               p, FxBlend::Add);
+    }
+}
