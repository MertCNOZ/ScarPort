+// A movie (the logos, the map transitions that are the loading screens) is a 4:3 frame. On a widened view it is
+// shown in proportion: zoomed until its picture fills the height, so letterbox bars are cut off, but never past the
+// screen's width (a 4:3 picture keeps bars at the sides). The rows with picture are found by their brightness, and
+// the zoom only eases out during a movie, so it does not jump around with dark frames.
+void D3D12Backend::FitMovie(const TextureDesc& d) {
+    movie_draw_ = true;
+    float k = app::WideFactor();
+    if (k <= 1.01f) {
+        movie_sx_ = movie_sy_ = 1;
+        return;
+    }
+    if (movie_.data != d.data || presents_ > movie_.frame + 30) movie_ = {};
+    movie_.data = d.data;
+    movie_.frame = presents_;
+    const uint8_t* p = static_cast<const uint8_t*>(kernel::HostPtr(d.data));
+    uint32_t pitch = d.pitch ? d.pitch : d.width * 4;
+    bool yuv = d.format == 0x24 || d.format == 0x25;
+    uint32_t bpp = yuv ? 2 : pitch >= d.width * 4 ? 4 : 2;
+    int top = -1, bottom = -1;
+    if (p && pitch >= d.width * bpp) {
+        for (uint32_t y = 0; y < d.height; y += 2) {
+            const uint8_t* row = p + size_t(y) * pitch;
+            bool lit = false;
+            for (uint32_t x = 8; x + 8 < d.width && !lit; x += 6) {
+                const uint8_t* px = row + size_t(x) * bpp;
+                uint32_t l = yuv ? px[d.format == 0x24 ? 0 : 1] : std::max({px[0], px[1], px[2]});
+                lit = l > 48;
+            }
+            if (lit) {
+                if (top < 0) top = int(y);
+                bottom = int(y);
+            }
+        }
+    }
+    if (top >= 0) {
+        movie_.top = movie_.top < 0 ? top : std::min(movie_.top, top);
+        movie_.bottom = std::max(movie_.bottom, bottom);
+    }
+    float h = float(d.height), content = h / k;  // before any picture: as a 16:9 letterbox
+    if (movie_.top >= 0) {
+        float centre = h * 0.5f;
+        content = 2.0f * std::max(centre - float(movie_.top), float(movie_.bottom + 2) - centre);
+    }
+    movie_sy_ = std::clamp(h / std::max(content, 1.0f), 1.0f, k);
+    movie_sx_ = movie_sy_ / k;
+}
