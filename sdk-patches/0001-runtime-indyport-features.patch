+        occ += saturate((dot(n, v) - 0.08) / (len + 0.0001) - 0.05) * saturate(1 - len / (c.x * 2));
+    }
+    // faded out from 40 to 80 units away: far off it adds little, and the track's distant see-through cards
+    // (written to depth behind signs) would darken the sky about them
+    float v = lerp(saturate(1 - c.y * occ / 12), 1, saturate((dist - 40) / 40));
+    return float4(v, v, v, 1);
+}
+// c.zw: the step in uv along the blur; t0 ao, t1 depth
+float4 aoblur(O i) : SV_Target {
+    float z0 = abs(ViewPos(i.uv, max(Depth(i.uv), 0.00001)).z);
+    float sum = 0, wsum = 0;
+    [unroll] for (int k = -4; k <= 4; k++) {
+        float2 u = i.uv + c.zw * k;
+        float z = abs(ViewPos(u, max(Depth(u), 0.00001)).z);
+        float w = exp(-k * k / 8.0) * saturate(1 - abs(z - z0) / (0.05 * z0 + 0.01));
+        sum += t0.SampleLevel(ls, u, 0).r * w;
+        wsum += w;
+    }
+    float v = sum / max(wsum, 0.0001);
+    return float4(v, v, v, 1);
+}
+// a.x threshold, a.y knee; t0 the scene
+float4 bright(O i) : SV_Target {
+    float3 col = t0.SampleLevel(ls, i.uv, 0).rgb;
+    float m = dot(col, float3(0.2126, 0.7152, 0.0722));
+    float soft = clamp(m - a.x + a.y, 0, 2 * a.y);
+    soft = soft * soft / (4 * a.y + 0.00001);
+    float k = max(soft, m - a.x) / max(m, 0.0001);
+    return float4(col * k, 1);
+}
+// c.zw: a texel of the source
+float4 down(O i) : SV_Target {
+    float2 s = c.zw;
+    float3 col = t0.SampleLevel(ls, i.uv + s * float2(-0.5, -0.5), 0).rgb + t0.SampleLevel(ls, i.uv + s * float2(0.5, -0.5), 0).rgb +
+                 t0.SampleLevel(ls, i.uv + s * float2(-0.5, 0.5), 0).rgb + t0.SampleLevel(ls, i.uv + s * float2(0.5, 0.5), 0).rgb;
+    return float4(col * 0.25, 1);
+}
+// c.zw: the step in uv along the blur
+float4 blur(O i) : SV_Target {
+    const float w[5] = {0.2270270270, 0.1945945946, 0.1216216216, 0.0540540541, 0.0162162162};
+    float3 col = t0.SampleLevel(ls, i.uv, 0).rgb * w[0];
+    [unroll] for (int k = 1; k < 5; k++) {
+        col += t0.SampleLevel(ls, i.uv + c.zw * k, 0).rgb * w[k];
+        col += t0.SampleLevel(ls, i.uv - c.zw * k, 0).rgb * w[k];
+    }
+    return float4(col, 1);
+}
+// a.x strength; t0 the quarter, t1 the eighth
+float4 bloomadd(O i) : SV_Target {
+    float3 col = t0.SampleLevel(ls, i.uv, 0).rgb + t1.SampleLevel(ls, i.uv, 0).rgb;
+    return float4(col * a.x, 0);
+}
+// t0 the blurred ao
+float4 aomul(O i) : SV_Target {
+    float v = t0.SampleLevel(ls, i.uv, 0).r;
+    return float4(v, v, v, 1);
+}
