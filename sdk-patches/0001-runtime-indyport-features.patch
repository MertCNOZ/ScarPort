+        cv.Format = c.fmt;
+        if (FAILED(dev_->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &td, D3D12_RESOURCE_STATE_COPY_DEST, &cv,
+                                                 IID_PPV_ARGS(&c.res)))) {
