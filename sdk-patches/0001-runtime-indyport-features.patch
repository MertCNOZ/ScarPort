+bool D3D12Backend::EnsureFxBuf(FxBuf& b, uint32_t w, uint32_t h, DXGI_FORMAT fmt) {
+    w = std::max(w, 1u);
+    h = std::max(h, 1u);
+    if (b.res && b.w == w && b.h == h && b.fmt == fmt) return true;
+    if (b.res) CurrentFrame().garbage.push_back(b.res);
+    b.res.Reset();
+    if (b.rtv == ~0u) {
+        if (free_rtv_.empty()) return false;
+        b.rtv = free_rtv_.back();
+        free_rtv_.pop_back();
+    }
+    D3D12_HEAP_PROPERTIES hp{D3D12_HEAP_TYPE_DEFAULT};
+    D3D12_RESOURCE_DESC td = Texture2DDesc(fmt, w, h);
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    D3D12_CLEAR_VALUE cv{};
+    cv.Format = fmt;
+    b.state = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    if (FAILED(dev_->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &td, b.state, &cv, IID_PPV_ARGS(&b.res))))
+        return false;
+    dev_->CreateRenderTargetView(b.res.Get(), nullptr, Cpu(rtv_heap_.Get(), b.rtv, rtv_inc_));
+    b.w = w;
+    b.h = h;
+    b.fmt = fmt;
+    return true;
+}
+
+void D3D12Backend::FxPass(const char* entry, D3D12_CPU_DESCRIPTOR_HANDLE rh, DXGI_FORMAT rtv, uint32_t w, uint32_t h,
+                          std::initializer_list<std::pair<ID3D12Resource*, DXGI_FORMAT>> src, const float (&p)[20],
+                          FxBlend blend) {
+    uint64_t seed = uint64_t(rtv) << 2 | uint64_t(blend);
+    auto& pso = blit_psos_[Hash(entry, std::strlen(entry), Hash(kSceneFxHlsl, std::strlen(kSceneFxHlsl), seed))];
+    if (!pso) {
+        uint64_t hs;
+        ID3DBlob* vs = Compile(kSceneFxHlsl, "vs", "vs_5_0", hs);
+        ID3DBlob* ps = Compile(kSceneFxHlsl, entry, "ps_5_0", hs);
+        if (!vs || !ps) return;
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC dsc = FullScreenPipelineDesc(vs, ps, rtv);
+        auto& bl = dsc.BlendState.RenderTarget[0];
+        if (blend != FxBlend::None) {
+            bl.BlendEnable = TRUE;
+            bl.SrcBlend = blend == FxBlend::Add ? D3D12_BLEND_ONE : D3D12_BLEND_ZERO;
+            bl.DestBlend = blend == FxBlend::Add ? D3D12_BLEND_ONE : D3D12_BLEND_SRC_COLOR;
+            bl.SrcBlendAlpha = D3D12_BLEND_ZERO;
+            bl.DestBlendAlpha = D3D12_BLEND_ONE;
+            bl.BlendOp = bl.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+        }
+        if (FAILED(dev_->CreateGraphicsPipelineState(&dsc, IID_PPV_ARGS(&pso)))) return;
+    }
+    uint32_t slot = AllocSrvSlots(4);
+    auto it = src.begin();
+    for (int i = 0; i < 4; i++) {
+        D3D12_SHADER_RESOURCE_VIEW_DESC sv{};
+        bool has = i < 3 && it != src.end() && it->first;
+        sv.Format = has ? it->second : kBgra;
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        sv.Texture2D.MipLevels = 1;
+        dev_->CreateShaderResourceView(has ? it->first : nullptr, &sv, Cpu(srv_heap_.Get(), slot + i, srv_inc_));
+        if (it != src.end()) ++it;
+    }
+    Alloc cb = Upload(256, 256);
+    std::memcpy(cb.cpu, p, sizeof(p));
+    cl_->OMSetRenderTargets(1, &rh, FALSE, nullptr);
+    SetFullViewport(w, h);
+    DrawFullScreen(pso.Get(), cb.gpu, slot);
+    bound_rt_ = bound_ds_ = nullptr;
+}
+
+void D3D12Backend::FxPass(const char* entry, FxBuf& out, std::initializer_list<std::pair<ID3D12Resource*, DXGI_FORMAT>> src,
+                          const float (&p)[20]) {
+    Transition(out.res.Get(), out.state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    FxPass(entry, Cpu(rtv_heap_.Get(), out.rtv, rtv_inc_), out.fmt, out.w, out.h, src, p, FxBlend::None);
+    Transition(out.res.Get(), out.state, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+}
